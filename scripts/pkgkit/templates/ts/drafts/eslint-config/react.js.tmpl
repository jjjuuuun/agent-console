import reactHooks from "eslint-plugin-react-hooks";

import { createConfig } from "./index.js";

/**
 * `createConfig`에 React Hooks 규칙을 더한다(eslint-plugin-react-hooks 필요).
 * @param {Parameters<typeof createConfig>[0]} [options]
 * @returns {import("eslint").Linter.Config[]}
 */
export function createReactConfig(options) {
  return [
    ...createConfig(options),
    { files: ["**/*.{ts,tsx}"], plugins: { "react-hooks": reactHooks }, rules: reactHooks.configs.recommended.rules },
  ];
}

export default createReactConfig();
