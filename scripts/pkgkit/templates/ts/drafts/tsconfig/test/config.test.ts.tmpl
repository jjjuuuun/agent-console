import { readFileSync } from "node:fs";

import { expect, test } from "vitest";

import { configPath } from "{{name}}";

const load = (name: string) => JSON.parse(readFileSync(configPath(name), "utf8")) as { extends?: string; compilerOptions: Record<string, unknown> };

test("base.json은 엄격 모드와 번들러 해석을 켠다", () => {
  const { compilerOptions } = load("base");
  expect(compilerOptions.strict).toBe(true);
  expect(compilerOptions.moduleResolution).toBe("Bundler");
});

test("library.json은 base.json을 상속하고 선언 파일을 만든다", () => {
  const cfg = load("library");
  expect(cfg.extends).toBe("./base.json");
  expect(cfg.compilerOptions.declaration).toBe(true);
});

test("설정 파일은 패키지 밖 경로를 가리키지 않는다", () => {
  for (const name of ["base", "library"]) expect(JSON.stringify(load(name))).not.toContain("../");
});
