{
  "name": "{{name}}",
  "version": "{{version}}",
  "description": "{{description}}",
  "private": true,
  "license": "MIT",
  "type": "module",
  "agentConsole": { "kind": "{{kind}}" },
  "sideEffects": false,
  "files": ["dist", "src", "!src/**/*.test.ts", "!src/**/*.test.tsx", "README.md", "CHANGELOG.md", "LICENSE"],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "{{eslintConfigName}}": "{{inhouseRange}}",
    "{{tsconfigName}}": "{{inhouseRange}}",
    "@types/node": "{{dev.types_node}}",
    "eslint": "{{dev.eslint}}",
    "typescript": "{{dev.typescript}}",
    "vitest": "{{dev.vitest}}"
  }
}
