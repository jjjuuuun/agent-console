{
  "$comment": "claude-code 분류기 설정 스키마. 도구 이름 특수 처리·범주·태그·hook 등 행 대응은 모두 이 기본값(데이터)이고 설정 logs.sources[].config.classifier.config가 덮어쓴다(F-6). 코드에는 도구 이름 목록이 없다.",
  "type": "object",
  "$defs": {
    "pointer": {"type": "string", "pattern": "^(/.*)?$"},
    "match_value": {
      "oneOf": [
        {"type": "string"},
        {"type": "array", "items": {"type": "string"}, "minItems": 1}
      ]
    },
    "row_rule": {
      "type": "object",
      "required": ["match", "category"],
      "properties": {
        "name": {"type": "string", "title": "규칙 이름(설명용)"},
        "match": {
          "type": "object",
          "title": "조건",
          "description": "JSON 포인터 → 글롭(`*`·`?`, 목록이면 그중 하나). 모두 맞아야 한다. 참·거짓·숫자는 JSON 문자열(`true`)로 비교한다. 값이 없으면 맞지 않는다.",
          "minProperties": 1,
          "propertyNames": {"pattern": "^/"},
          "additionalProperties": {"$ref": "#/$defs/match_value"}
        },
        "category": {"type": "string", "minLength": 1, "title": "범주(기본)"},
        "title": {"type": "string", "default": "", "title": "제목 틀", "description": "`{/포인터}`를 그 값으로 바꾼다."},
        "stage": {"type": "string", "default": "info"},
        "status": {"type": "string", "default": ""},
        "fields": {
          "type": "object",
          "title": "필드 대응",
          "description": "초안 필드 → JSON 포인터. category·status·stage는 value_maps로 값을 바꿀 수 있다(category는 대응표에 없으면 기본 범주).",
          "propertyNames": {"enum": ["category", "stage", "status", "tool", "via", "model", "message_id", "turn_id", "role"]},
          "additionalProperties": {"$ref": "#/$defs/pointer"},
          "default": {}
        },
        "value_maps": {
          "type": "object",
          "additionalProperties": {"type": "object", "additionalProperties": {"type": "string"}},
          "default": {}
        },
        "correlation": {
          "type": "object",
          "title": "상관 근거",
          "description": "근거 이름 → JSON 포인터(값이 있을 때만).",
          "additionalProperties": {"$ref": "#/$defs/pointer"},
          "default": {}
        },
        "tags": {"type": "array", "items": {"type": "string"}, "default": []},
        "detail": {"$ref": "#/$defs/pointer", "default": "", "description": "detail로 쓸 부분(빈 문자열 = 행 전체)."},
        "summary": {"$ref": "#/$defs/summary_pointers", "description": "목록 요약으로 쓸 평문(detail 기준 포인터 또는 `{/포인터}` 틀, 앞쪽부터 처음 글이 나오는 것). 비면 detail 전체를 문자열로."}
      }
    },
    "summary_item": {
      "type": "string",
      "description": "`/`로 시작하고 `{/`가 없으면 JSON 포인터(빈 문자열 = detail 전체), 그 밖은 틀: `{/포인터}`를 그 값(문자열·text 블록·숫자·참거짓)으로, `{/포인터|keys}`를 객체 키 목록(`, `)으로, `{/포인터|count}`를 목록·객체 항목 수로 바꾼다. 틀은 자리 표시가 모두 값이 있을 때만 쓰인다(자리 표시가 없는 틀은 그대로 글자)."
    },
    "summary_pointers": {
      "type": "array",
      "items": {"$ref": "#/$defs/summary_item"},
      "default": []
    },
    "path_tool": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path_pointer": {"$ref": "#/$defs/pointer", "default": "/file_path"},
        "action": {"type": "string", "default": "modified"}
      }
    }
  },
  "properties": {
    "categories": {
      "type": "object",
      "title": "범주 id",
      "description": "행 종류별로 낼 범주 id(분류 체계의 id, 열린 문자열).",
      "properties": {
        "input": {"type": "string", "default": "input"},
        "assistant_text": {"type": "string", "default": "llm"},
        "thinking": {"type": "string", "default": "llm"},
        "tool_call": {"type": "string", "default": "tool"},
        "tool_result": {"type": "string", "default": "tool"},
        "mcp_call": {"type": "string", "default": "mcp"},
        "delegation": {"type": "string", "default": "handoff"},
        "delegation_result": {"type": "string", "default": "merge"},
        "api_error": {"type": "string", "default": "error"},
        "other": {"type": "string", "default": "other"}
      },
      "default": {
        "input": "input", "assistant_text": "llm", "thinking": "llm", "tool_call": "tool",
        "tool_result": "tool", "mcp_call": "mcp", "delegation": "handoff",
        "delegation_result": "merge", "api_error": "error", "other": "other"
      }
    },
    "tags": {
      "type": "object",
      "title": "추가 태그",
      "description": "행 종류별로 덧붙일 태그(도구 이벤트에는 코어 약속 태그 `tool`이 항상 붙는다).",
      "properties": {
        "tool_call": {"type": "array", "items": {"type": "string"}, "default": ["tool_call"]},
        "tool_result": {"type": "array", "items": {"type": "string"}, "default": ["tool_result"]},
        "tool_failed": {"type": "array", "items": {"type": "string"}, "default": ["error"]},
        "mcp": {"type": "array", "items": {"type": "string"}, "default": ["mcp"]},
        "delegation": {"type": "array", "items": {"type": "string"}, "default": ["agent"]}
      },
      "default": {
        "tool_call": ["tool_call"], "tool_result": ["tool_result"], "tool_failed": ["error"],
        "mcp": ["mcp"], "delegation": ["agent"]
      }
    },
    "delegation_tools": {
      "type": "array",
      "title": "위임 도구",
      "description": "서브에이전트에 일을 넘기는 도구. 대상 thread는 출처가 서브에이전트 메타에서 찾은 값, 없으면 fallback_target(`{value}` = target_pointer 값).",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "target_pointer": {"$ref": "#/$defs/pointer", "default": "/subagent_type"},
          "via": {"type": "string", "default": ""},
          "fallback_target": {"type": "string", "default": "{value}"}
        }
      },
      "default": [
        {"name": "Agent", "target_pointer": "/subagent_type", "via": "Agent 도구", "fallback_target": "role:{value}"},
        {"name": "Task", "target_pointer": "/subagent_type", "via": "Agent 도구", "fallback_target": "role:{value}"}
      ]
    },
    "delegation_result": {
      "type": "object",
      "title": "위임 결과",
      "description": "도구 결과 행의 이 포인터에 서브에이전트 id가 있으면 위임 결과(from = 서브에이전트 thread)로 본다.",
      "properties": {
        "agent_id_pointer": {"$ref": "#/$defs/pointer", "default": "/toolUseResult/agentId"},
        "via": {"type": "string", "default": "Agent 도구"}
      },
      "default": {"agent_id_pointer": "/toolUseResult/agentId", "via": "Agent 도구"}
    },
    "subagent_thread_template": {
      "type": "string",
      "default": "agent-{value}",
      "title": "서브에이전트 thread 이름",
      "description": "서브에이전트 id → thread(출처의 파일 이름 agent-<id>.jsonl과 같게)."
    },
    "file_change_tools": {
      "type": "array",
      "title": "파일 변경 도구",
      "description": "호출 이벤트에 문서(경로·action)를 붙인다. 실제 성공 여부는 같은 call_id의 결과 이벤트 상태로 본다.",
      "items": {"$ref": "#/$defs/path_tool"},
      "default": [
        {"name": "Write", "path_pointer": "/file_path", "action": "created"},
        {"name": "Edit", "path_pointer": "/file_path", "action": "modified"},
        {"name": "MultiEdit", "path_pointer": "/file_path", "action": "modified"},
        {"name": "NotebookEdit", "path_pointer": "/notebook_path", "action": "modified"}
      ]
    },
    "document_read_tools": {
      "type": "array",
      "title": "문서 읽기 도구",
      "items": {"$ref": "#/$defs/path_tool"},
      "default": [{"name": "Read", "path_pointer": "/file_path", "action": "read_requested"}]
    },
    "document_kinds": {
      "type": "object",
      "title": "문서 종류",
      "description": "파일 이름 → 문서 종류. 없으면 default_document_kind.",
      "additionalProperties": {"type": "string"},
      "default": {"SPEC.md": "spec", "CLAUDE.md": "agents_md", "AGENTS.md": "agents_md", "SKILL.md": "skill"}
    },
    "default_document_kind": {"type": "string", "default": "document"},
    "mcp_tool_pattern": {
      "type": "string",
      "title": "MCP 도구 이름 틀",
      "description": "자리 표시 {server}·{tool}(각각 한 번)과 *(아무 글자)로 쓴 이름 틀. 이름 전체가 맞는 도구 호출은 MCP 호출이 된다. 빈 문자열이면 MCP를 따로 보지 않는다.",
      "default": "mcp__{server}__{tool}"
    },
    "session_title_skip_prefixes": {
      "type": "array",
      "items": {"type": "string"},
      "title": "세션 제목에서 뺄 입력",
      "description": "이 접두사로 시작하는 사용자 입력은 세션 제목 후보로 보지 않는다(명령 표시 등).",
      "default": ["<command-", "<local-command-", "Caveat:"]
    },
    "session_title_from_input": {
      "type": "boolean",
      "default": true,
      "title": "사용자 입력을 세션 제목 후보로",
      "description": "끄면 사용자 입력에 session_title 태그를 붙이지 않는다. 그러면 행 규칙이 붙인 후보(기본: custom-title·ai-title 행)만 세션 제목이 된다. 세션 제목은 코어의 세션 제목 순위 규칙(데이터)으로 고른다 — 기본: 마지막 session_title.renamed(custom-title) > 마지막 session_title.generated(ai-title) > 첫 session_title(입력)."
    },
    "title_chars": {"type": "integer", "minimum": 8, "default": 80, "title": "입력 제목 길이"},
    "summaries": {
      "type": "object",
      "title": "목록 요약",
      "description": "행 종류(categories와 같은 이름)별로 목록 요약에 쓸 평문의 위치(이벤트 detail 기준 JSON 포인터 또는 `{/포인터}` 틀, 앞쪽부터 처음 글이 나오는 것). 값이 문자열이면 그대로, 내용 블록 목록이면 text 블록을 이어 붙인다. 맞는 것이 없으면 detail 전체를 문자열로 쓴다. 원문은 detail·raw에 그대로 남는다.",
      "additionalProperties": {"$ref": "#/$defs/summary_pointers"},
      "properties": {
        "input": {"$ref": "#/$defs/summary_pointers", "default": ["/text"]},
        "assistant_text": {"$ref": "#/$defs/summary_pointers", "default": ["/text"]},
        "api_error": {"$ref": "#/$defs/summary_pointers", "default": ["/text"]},
        "thinking": {"$ref": "#/$defs/summary_pointers", "default": ["/note"]},
        "tool_call": {"$ref": "#/$defs/summary_pointers", "default": ["/input/description", "/input/command", "/input/file_path", "/input/path", "/input/pattern", "/input/query", "/input/url", "/input/prompt", "{/name} · {/input/id}", "{/name}"]},
        "mcp_call": {"$ref": "#/$defs/summary_pointers", "default": ["{/server}/{/tool} · {/input/description}", "{/server}/{/tool} · {/input/query}", "{/server}/{/tool} · {/input/prompt}", "{/server}/{/tool} · {/input/title}", "{/server}/{/tool} · {/input/url}", "{/server}/{/tool} · {/input/path}", "{/server}/{/tool}"]},
        "delegation": {"$ref": "#/$defs/summary_pointers", "default": ["/input/description", "/input/prompt", "{/input/subagent_type}"]},
        "tool_result": {"$ref": "#/$defs/summary_pointers", "default": ["/output", "{/output/0/type} 블록 {/output|count}개", "결과 없음"]},
        "delegation_result": {"$ref": "#/$defs/summary_pointers", "default": ["/output", "{/output/0/type} 블록 {/output|count}개", "결과 없음"]},
        "other": {"$ref": "#/$defs/summary_pointers", "default": []}
      },
      "default": {
        "input": ["/text"],
        "assistant_text": ["/text"],
        "api_error": ["/text"],
        "thinking": ["/note"],
        "tool_call": ["/input/description", "/input/command", "/input/file_path", "/input/path", "/input/pattern", "/input/query", "/input/url", "/input/prompt", "{/name} · {/input/id}", "{/name}"],
        "mcp_call": ["{/server}/{/tool} · {/input/description}", "{/server}/{/tool} · {/input/query}", "{/server}/{/tool} · {/input/prompt}", "{/server}/{/tool} · {/input/title}", "{/server}/{/tool} · {/input/url}", "{/server}/{/tool} · {/input/path}", "{/server}/{/tool}"],
        "delegation": ["/input/description", "/input/prompt", "{/input/subagent_type}"],
        "tool_result": ["/output", "{/output/0/type} 블록 {/output|count}개", "결과 없음"],
        "delegation_result": ["/output", "{/output/0/type} 블록 {/output|count}개", "결과 없음"],
        "other": []
      }
    },
    "thinking_block_types": {
      "type": "array",
      "items": {"type": "string"},
      "default": ["thinking", "redacted_thinking"],
      "title": "내부 추론 블록",
      "description": "이 종류의 내용 블록은 본문을 저장하지 않는다(있었다는 표시만)."
    },
    "thinking_note": {"type": "string", "default": "내부 추론 본문 생략"},
    "extra_row_rules": {
      "type": "array",
      "title": "추가 행 규칙",
      "description": "row_rules보다 먼저 본다(기본 규칙을 고치지 않고 덧붙일 때).",
      "items": {"$ref": "#/$defs/row_rule"},
      "default": []
    },
    "row_rules": {
      "type": "array",
      "title": "행 규칙",
      "description": "사용자·응답 행 해석보다 먼저 보는 선언형 대응(hook·attachment·system·progress 등). 처음 맞는 규칙이 이긴다. 어느 규칙에도, 사용자·응답 행에도 맞지 않으면 categories.other로 원문을 보존한다.",
      "items": {"$ref": "#/$defs/row_rule"},
      "default": [
        {"name": "compact", "match": {"/type": "system", "/subtype": "compact_boundary"}, "category": "context", "title": "컨텍스트 압축", "summary": ["/content"]},
        {"name": "microcompact", "match": {"/type": "system", "/subtype": "microcompact_boundary"}, "category": "context", "title": "컨텍스트 부분 압축"},
        {"name": "stop-hook-summary", "match": {"/type": "system", "/subtype": "stop_hook_summary"}, "category": "hook", "title": "hook 요약 · {/hookCount}개", "stage": "complete",
         "fields": {"status": "/preventedContinuation"}, "value_maps": {"status": {"true": "blocked", "false": "completed"}},
         "correlation": {"tool_use_id": "/toolUseID"}, "tags": ["hook"],
         "summary": ["/stopReason", "/hookAdditionalContext", "{/hookInfos/0/command}"]},
        {"name": "api-error", "match": {"/type": "system", "/subtype": "api_error"}, "category": "error", "title": "API 오류", "status": "failed", "summary": ["/content", "/error/message"]},
        {"name": "system", "match": {"/type": "system"}, "category": "system", "title": "시스템 · {/subtype}", "summary": ["/content"]},
        {"name": "hook-progress", "match": {"/type": "progress", "/data/type": "hook_progress"}, "category": "hook", "title": "hook 실행 · {/data/hookName}", "stage": "start",
         "correlation": {"tool_use_id": "/toolUseID", "parent_tool_use_id": "/parentToolUseID", "hook_event": "/data/hookEvent"}, "tags": ["hook"], "detail": "/data",
         "summary": ["{/hookName} · {/command}", "{/hookEvent} · {/command}", "/hookName", "/command"]},
        {"name": "mcp-progress", "match": {"/type": "progress", "/data/type": "mcp_progress"}, "category": "mcp", "title": "MCP 진행 · {/data/serverName}/{/data/toolName} · {/data/status}",
         "fields": {"status": "/data/status"}, "correlation": {"tool_use_id": "/parentToolUseID"}, "tags": ["mcp"], "detail": "/data",
         "summary": ["{/serverName}/{/toolName} · {/status}", "{/serverName}/{/toolName}"]},
        {"name": "progress", "match": {"/type": "progress"}, "category": "other", "title": "진행 · {/data/type}", "detail": "/data",
         "correlation": {"tool_use_id": "/parentToolUseID"}},
        {"name": "hook-attachment", "match": {"/type": "attachment", "/attachment/type": "hook_*"}, "category": "hook", "title": "hook · {/attachment/hookName}", "stage": "complete",
         "fields": {"status": "/attachment/type", "category": "/attachment/type"},
         "value_maps": {
           "status": {"hook_success": "completed", "hook_blocking_error": "blocked", "hook_non_blocking_error": "failed", "hook_error_during_execution": "failed",
                      "hook_cancelled": "cancelled", "hook_stopped_continuation": "blocked", "hook_additional_context": "completed",
                      "hook_permission_decision": "completed", "hook_system_message": "completed"},
           "category": {"hook_non_blocking_error": "error", "hook_error_during_execution": "error"}
         },
         "correlation": {"tool_use_id": "/attachment/toolUseID", "hook_event": "/attachment/hookEvent"}, "tags": ["hook"], "detail": "/attachment",
         "summary": ["{/hookName} · {/content}", "{/hookName} · {/stdout}", "{/hookName} · {/stderr}", "{/hookName} · 종료 코드 {/exitCode}", "{/hookName} · {/type}", "/content", "/stdout", "/stderr"]},
        {"name": "attachment-text", "match": {"/type": "attachment", "/attachment/type": ["total_tokens_reminder", "silent_turn_reminder"]}, "category": "context", "title": "첨부 맥락 · {/attachment/type}", "detail": "/attachment", "summary": ["/text", "{/type}"]},
        {"name": "attachment-file", "match": {"/type": "attachment", "/attachment/type": ["edited_text_file", "compact_file_reference"]}, "category": "context", "title": "첨부 맥락 · {/attachment/type}", "detail": "/attachment", "summary": ["{/type} · {/filename}", "{/type}"]},
        {"name": "attachment-deferred-tools", "match": {"/type": "attachment", "/attachment/type": "deferred_tools_record"}, "category": "context", "title": "첨부 맥락 · {/attachment/type}", "detail": "/attachment",
         "summary": ["지연 도구 {/entries|count}개 · 입력 사본 {/toolInputCopies|count}개", "지연 도구 {/entries|count}개", "{/type}"]},
        {"name": "attachment-date", "match": {"/type": "attachment", "/attachment/type": "date"}, "category": "context", "title": "첨부 맥락 · {/attachment/type}", "detail": "/attachment", "summary": ["날짜 {/date}", "{/type}"]},
        {"name": "attachment-language", "match": {"/type": "attachment", "/attachment/type": "language"}, "category": "context", "title": "첨부 맥락 · {/attachment/type}", "detail": "/attachment", "summary": ["언어 {/language}", "{/type}"]},
        {"name": "attachment-command-permissions", "match": {"/type": "attachment", "/attachment/type": "command_permissions"}, "category": "context", "title": "첨부 맥락 · {/attachment/type}", "detail": "/attachment", "summary": ["허용 도구 {/allowedTools|count}개", "{/type}"]},
        {"name": "attachment-credential", "match": {"/type": "attachment", "/attachment/type": ["credential*", "*secret*", "*password*", "*auth*"]}, "category": "context", "title": "첨부 맥락 · {/attachment/type}", "detail": "/attachment", "summary": ["{/type} (값은 요약에 넣지 않음)"]},
        {"name": "attachment", "match": {"/type": "attachment"}, "category": "context", "title": "첨부 맥락 · {/attachment/type}", "detail": "/attachment", "summary": ["{/type}"]},
        {"name": "meta-input", "match": {"/type": "user", "/isMeta": "true"}, "category": "context", "title": "메타 입력"},
        {"name": "summary", "match": {"/type": "summary"}, "category": "context", "title": "요약 · {/summary}"},
        {"name": "custom-title", "match": {"/type": "custom-title"}, "category": "other", "title": "{/customTitle}", "tags": ["session_title", "session_title.renamed"], "summary": ["세션 이름(/rename)"]},
        {"name": "ai-title", "match": {"/type": "ai-title"}, "category": "meta", "title": "{/aiTitle}", "tags": ["session_title", "session_title.generated"], "summary": ["세션 제목(자동 생성)"]},
        {"name": "atis-latch", "match": {"/type": "atis-latch"}, "category": "meta", "title": "atis-latch", "summary": ["atis {/atis}", "{/type}"]},
        {"name": "agent-name", "match": {"/type": "agent-name"}, "category": "other", "title": "에이전트 이름 · {/agentName}", "summary": ["/agentName"]},
        {"name": "permission-mode", "match": {"/type": "permission-mode"}, "category": "control", "title": "권한 모드 · {/permissionMode}", "summary": ["/permissionMode"]},
        {"name": "mode", "match": {"/type": "mode"}, "category": "control", "title": "모드 · {/mode}", "summary": ["/mode"]},
        {"name": "queue-operation", "match": {"/type": "queue-operation"}, "category": "meta", "title": "입력 대기열 · {/operation}", "summary": ["{/operation} · {/content}", "/operation"]},
        {"name": "cost-state", "match": {"/type": "cost-state"}, "category": "meta", "title": "비용 상태"},
        {"name": "api-request", "match": {"/type": "api-request*"}, "category": "meta", "title": "API 요청 기록 · {/type}"},
        {"name": "last-prompt", "match": {"/type": "last-prompt"}, "category": "other", "title": "마지막 입력", "summary": ["/lastPrompt"]},
        {"name": "file-history", "match": {"/type": "file-history-*"}, "category": "meta", "title": "파일 기록 · {/type}",
         "summary": ["/trackingPath", "{/snapshot/trackedFileBackups|keys}", "추적 파일 없음"]}
      ]
    }
  }
}
