{
  "name": "@agent-console/i18n",
  "version": "0.1.0",
  "description": "i18next setup, language resolution, formatters and React hooks for Agent Console web UIs",
  "private": true,
  "license": "MIT",
  "type": "module",
  "agentConsole": {
    "kind": "lib"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@agent-console/eslint-config": "^0.1.0",
    "@agent-console/tsconfig": "^0.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@agent-console/contracts": "^0.16.0",
    "i18next": "27.2.9",
    "react-i18next": "18.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
