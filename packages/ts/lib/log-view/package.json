{
  "name": "@agent-console/log-view",
  "version": "0.2.3",
  "description": "Log analysis presentation components (event table, filters, details, session list, playback bar, dashboard grid) and the widget registry",
  "private": true,
  "license": "MIT",
  "type": "module",
  "agentConsole": {
    "kind": "lib",
    "extensionPoints": {
      "dashboard-widget": {
        "title": "Dashboard widget",
        "area": "web",
        "design_id": "X21",
        "summary": "Adds a new widget kind to the dashboard",
        "registration": {
          "kind": "props",
          "export": "@agent-console/log-view#DashboardGridProps"
        },
        "interface": [
          "@agent-console/log-view#WidgetDescriptor",
          "@agent-console/log-view#WidgetRenderProps",
          "@agent-console/log-view#WidgetRegistry",
          "@agent-console/log-view#createWidgetRegistry"
        ],
        "example": {
          "kind": "package",
          "path": "examples/web/agent-console-example-web"
        },
        "guide": "web.md#dashboard-widget"
      }
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./locales/ko": {
      "development": "./src/locales/ko.ts",
      "types": "./dist/locales/ko.d.ts",
      "default": "./dist/locales/ko.js"
    },
    "./locales/en": {
      "development": "./src/locales/en.ts",
      "types": "./dist/locales/en.d.ts",
      "default": "./dist/locales/en.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-console/contracts": "^0.16.0",
    "@agent-console/virtual-rows": "^0.1.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@agent-console/eslint-config": "^0.1.0",
    "@agent-console/tsconfig": "^0.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
