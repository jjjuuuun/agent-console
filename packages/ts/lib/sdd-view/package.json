{
  "name": "@agent-console/sdd-view",
  "version": "0.1.0",
  "description": "스펙(SDD) 표현 컴포넌트: 문서 편집기·작업 표·계획 그래프·추적 표",
  "private": true,
  "license": "MIT",
  "type": "module",
  "agentConsole": { "kind": "lib" },
  "sideEffects": ["**/*.css"],
  "files": ["dist", "src", "!src/**/*.test.ts", "!src/**/*.test.tsx", "README.md", "CHANGELOG.md", "LICENSE"],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-console/contracts": "^0.14.0",
    "@agent-console/markdown-doc": "^0.1.0",
    "@tanstack/react-virtual": "^3.14.21",
    "@xyflow/react": "^12.12.0",
    "elkjs": "~0.12.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@agent-console/eslint-config": "^0.1.0",
    "@agent-console/tsconfig": "^0.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.11.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
