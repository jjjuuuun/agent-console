{
  "name": "@agent-console/projects",
  "version": "0.1.0",
  "description": "프로젝트(정의·대화·실행의 범위) 재사용 로직: 보기 규칙, 기본 범위, 배지, 로그 필터, 현재 프로젝트 상태, REST 클라이언트",
  "private": true,
  "license": "MIT",
  "type": "module",
  "agentConsole": { "kind": "lib" },
  "sideEffects": false,
  "files": ["dist", "src", "!src/**/*.test.ts", "!src/**/*.test.tsx", "README.md", "CHANGELOG.md", "LICENSE"],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-console/contracts": "^0.10.0"
  },
  "devDependencies": {
    "@agent-console/eslint-config": "^0.1.0",
    "@agent-console/tsconfig": "^0.1.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
