{
  "name": "@agent-console/tsconfig",
  "version": "0.1.0",
  "description": "Agent Console TS 패키지 공용 tsconfig(base.json, library.json)",
  "private": true,
  "license": "MIT",
  "type": "module",
  "agentConsole": {
    "kind": "config"
  },
  "files": [
    "index.js",
    "*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./*.json": "./*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@agent-console/eslint-config": "^0.1.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
