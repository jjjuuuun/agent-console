{
  "name": "@agent-console/web",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "agentConsole": {
    "kind": "app",
    "extensionPoints": {
      "config-form-widget": {
        "title": "Settings form widget",
        "area": "web",
        "design_id": "X51",
        "summary": "Connects a UI component to a `ui:widget` name in a settings schema",
        "registration": {
          "kind": "registry",
          "name": "@agent-console/web/src/features/delegation/configWidgets.ts#CONFIG_WIDGETS"
        },
        "interface": [
          "@agent-console/web/src/features/delegation/widgetRegistry#WidgetRegistry",
          "@agent-console/web/src/features/delegation/widgetRegistry#ConfigWidget"
        ],
        "example": {
          "kind": "package",
          "path": "examples/web/agent-console-example-web"
        },
        "guide": "web.md#config-form-widget"
      },
      "screen-entry": {
        "title": "Screen entry",
        "area": "web",
        "design_id": "X52",
        "summary": "Adds a new screen to the sidebar with one route data entry and a page mapping",
        "registration": {
          "kind": "registry",
          "name": "@agent-console/web/src/shell/routeConfig.ts#DEFAULT_ROUTES"
        },
        "interface": [
          "@agent-console/web/src/shell/routeConfig.ts#RouteDef",
          "@agent-console/web/src/shell/routes.tsx#PageTable",
          "@agent-console/web/src/shell/routes.tsx#DEFAULT_PAGES"
        ],
        "example": {
          "kind": "reference",
          "path": "apps/web"
        },
        "guide": "web.md#screen-entry"
      },
      "interaction-renderer": {
        "title": "Interaction renderer",
        "area": "web",
        "design_id": "X53",
        "summary": "Connects a response UI component to an interaction renderer name",
        "registration": {
          "kind": "props",
          "export": "@agent-console/chat#defaultRenderers"
        },
        "interface": [
          "@agent-console/chat#RendererComponent",
          "@agent-console/chat#RendererProps"
        ],
        "example": {
          "kind": "reference",
          "path": "packages/ts/lib/chat"
        },
        "guide": "web.md#interaction-renderer"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agent-console/api-client": "^0.2.1",
    "@agent-console/arch-view": "^0.2.1",
    "@agent-console/chat": "^0.2.1",
    "@agent-console/contracts": "^0.16.1",
    "@agent-console/folder-picker": "^0.2.0",
    "@agent-console/graph-editor": "^0.2.2",
    "@agent-console/i18n": "^0.2.0",
    "@agent-console/list-arrange": "^0.1.1",
    "@agent-console/log-view": "^0.2.1",
    "@agent-console/markdown-doc": "^0.2.0",
    "@agent-console/memory-view": "^0.2.1",
    "@agent-console/projects": "^0.3.0",
    "@agent-console/schema-form": "^0.2.0",
    "@agent-console/sdd-view": "^0.2.0",
    "@agent-console/text-editor": "^0.1.0",
    "@agent-console/trace-view": "^0.2.0",
    "@agent-console/ui": "^0.2.1",
    "@agent-console/wiki-view": "^0.2.1",
    "@tanstack/react-query": "^5.104.3",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.9.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@agent-console/tsconfig": "^0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
