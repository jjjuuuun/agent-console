{
  "name": "@agent-console/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "agentConsole": {
    "kind": "app",
    "extensionPoints": {
      "config-form-widget": {
        "title": "설정 폼 위젯",
        "area": "web",
        "design_id": "X51",
        "summary": "설정 스키마의 ui:widget 이름에 화면 컴포넌트를 연결한다",
        "registration": {
          "kind": "registry",
          "name": "@agent-console/web/src/features/delegation/configWidgets.ts#CONFIG_WIDGETS"
        },
        "interface": [
          "@agent-console/web/src/features/delegation/widgetRegistry#WidgetRegistry",
          "@agent-console/web/src/features/delegation/widgetRegistry#ConfigWidget"
        ],
        "example": {
          "kind": "package",
          "path": "examples/web/agent-console-example-web"
        },
        "guide": "web.md#config-form-widget"
      },
      "screen-entry": {
        "title": "화면 진입",
        "area": "web",
        "design_id": "X52",
        "summary": "라우트 데이터 한 줄과 화면 연결로 새 화면을 사이드바에 넣는다",
        "registration": {
          "kind": "registry",
          "name": "@agent-console/web/src/shell/routeConfig.ts#DEFAULT_ROUTES"
        },
        "interface": [
          "@agent-console/web/src/shell/routeConfig.ts#RouteDef",
          "@agent-console/web/src/shell/routes.tsx#PageTable",
          "@agent-console/web/src/shell/routes.tsx#DEFAULT_PAGES"
        ],
        "example": {
          "kind": "reference",
          "path": "apps/web"
        },
        "guide": "web.md#screen-entry"
      },
      "interaction-renderer": {
        "title": "상호작용 renderer",
        "area": "web",
        "design_id": "X53",
        "summary": "상호작용 renderer 이름에 응답 화면 컴포넌트를 연결한다",
        "registration": {
          "kind": "props",
          "export": "@agent-console/chat#defaultRenderers"
        },
        "interface": [
          "@agent-console/chat#RendererComponent",
          "@agent-console/chat#RendererProps"
        ],
        "example": {
          "kind": "reference",
          "path": "packages/ts/lib/chat"
        },
        "guide": "web.md#interaction-renderer"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agent-console/api-client": "^0.1.0",
    "@agent-console/arch-view": "^0.1.0",
    "@agent-console/chat": "^0.1.0",
    "@agent-console/contracts": "^0.14.0",
    "@agent-console/folder-picker": "^0.1.0",
    "@agent-console/graph-editor": "^0.1.0",
    "@agent-console/list-arrange": "^0.1.0",
    "@agent-console/log-view": "^0.1.0",
    "@agent-console/markdown-doc": "^0.1.0",
    "@agent-console/memory-view": "^0.1.0",
    "@agent-console/projects": "^0.1.0",
    "@agent-console/schema-form": "^0.1.0",
    "@agent-console/sdd-view": "^0.1.0",
    "@agent-console/text-editor": "^0.1.0",
    "@agent-console/trace-view": "^0.1.0",
    "@agent-console/ui": "^0.1.0",
    "@agent-console/wiki-view": "^0.1.0",
    "@tanstack/react-query": "^5.104.3",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.9.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@agent-console/tsconfig": "^0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
